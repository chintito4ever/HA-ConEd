#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# ConEd Scraper - Prisma Studio (Database UI) - OPTIONAL SERVICE
# ==============================================================================

exec 2>&1

# Fixed ports (internal use)
PRISMA_STUDIO_PORT="5555"
POSTGRES_PORT="5432"

cd /app/python-service

# Studio has no login: anyone who can reach the port can read and change the
# database, including saved ConEd credentials. Only run it when turned on.
if ! bashio::config.true 'prisma_studio'; then
    bashio::log.info "Prisma Studio is off (turn on 'prisma_studio' in the add-on configuration to use it)"
    exec sleep infinity
fi

# Wait for PostgreSQL and coned database to be ready
bashio::log.info "Waiting for PostgreSQL before Prisma Studio..."
until PGPASSWORD=coned psql -h localhost -p "${POSTGRES_PORT}" -U coned -d coned -t -c "SELECT 1" > /dev/null 2>&1; do
    sleep 2
done
sleep 2
bashio::log.info "PostgreSQL is ready, starting Prisma Studio on port ${PRISMA_STUDIO_PORT}..."

# Prisma 6 reads the database from the schema's DATABASE_URL (it has no --url option)
export DATABASE_URL="postgresql://coned:coned@localhost:${POSTGRES_PORT}/coned"
prisma studio --schema prisma/schema.prisma --port "${PRISMA_STUDIO_PORT}" --hostname 0.0.0.0 --browser none
status=$?

# Studio is optional. If it can't run, say so once and stay idle instead of
# letting s6 restart it every few seconds.
bashio::log.warning "Prisma Studio exited (code ${status}); not restarting. The addon works without it."
exec sleep infinity
